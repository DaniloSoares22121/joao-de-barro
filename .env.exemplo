# Copie para ".env" e preencha.

# Chave da API da Anthropic (console.anthropic.com). Sem ela, o servidor usa o login do
# Claude Code deste computador, se houver.
ANTHROPIC_API_KEY=

# Modelos (opcional)
# LOVABLE_MODEL=claude-sonnet-5
# LOVABLE_LIGHT_MODEL=claude-haiku-5-5

# Porta e endereco (opcional). 0.0.0.0 abre para a rede local.
# JDB_PORT=8870
# JDB_HOST=127.0.0.1
